;
; rapl-pkg.inf: primitive (non-PnP) driver package for the RaplPkg control device.
; Install: pnputil /add-driver rapl-pkg.inf /install ; start: sc.exe start rapl-pkg
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderName%
DriverVer   = 11/14/2026,0.3.0.0
CatalogFile = rapl-pkg.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
rapl-pkg.sys = 1,,

[DefaultInstall.NTamd64]
CopyFiles = RaplPkg.CopyFiles

[DefaultInstall.NTamd64.Services]
AddService = rapl-pkg,,RaplPkg.Service

[RaplPkg.CopyFiles]
rapl-pkg.sys

[RaplPkg.Service]
DisplayName   = %ServiceName%
Description   = %ServiceDescription%
ServiceType   = 1 ; SERVICE_KERNEL_DRIVER
StartType     = 3 ; SERVICE_DEMAND_START
ErrorControl  = 1 ; SERVICE_ERROR_NORMAL
ServiceBinary = %13%\rapl-pkg.sys

[Strings]
ProviderName       = "win-mmio-msr-cli"
DiskName           = "RaplPkg installation disk"
ServiceName        = "RaplPkg RAPL access driver"
ServiceDescription = "Fixed-register access to the Intel package RAPL power limit (win-mmio-msr-cli)."
