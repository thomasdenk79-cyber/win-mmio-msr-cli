; Skeleton INF. The Windows agent must fill the WDK catalog/signature fields.
[Version]
Signature="$Windows NT$"
Class=System
ClassGuid={36fc9e60-c465-11cf-8056-444553540000}
Provider=%Provider%
DriverVer=11/14/2026,0.1.0.0
CatalogFile=rapl-pkg.cat

[DefaultInstall.NTamd64]
CopyFiles=DriverCopy

[DefaultInstall.NTamd64.Services]
AddService=rapl-pkg,0x00000002,ServiceInstall

[DriverCopy]
rapl-pkg.sys

[ServiceInstall]
DisplayName=%ServiceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\\rapl-pkg.sys

[Strings]
Provider="win-mmio-msr-cli"
ServiceName="RAPL Package Access (signed build required)"
