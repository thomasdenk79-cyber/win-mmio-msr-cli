<?xml version="1.0" encoding="utf-8"?>
<!--
  KMDF build of rapl-pkg.sys. Requires Visual Studio 2022 with the WDK extension:
    msbuild driver\rapl-pkg.vcxproj -p:Configuration=Release -p:Platform=x64
  Output: target\driver\x64\Release\rapl-pkg\ (rapl-pkg.sys, stamped INF, unsigned catalog).
  Build-time gates (README.md): -p:RaplEnableMmioRead=1, -p:RaplMmioLayoutValidated=1,
  -p:RaplEnableLiveWrites=1. All default to 0 (read-only MSR access).
-->
<Project DefaultTargets="Build" ToolsVersion="12.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{8EE310F5-5E5E-4F01-9848-18B9B8676B0A}</ProjectGuid>
    <RootNamespace>rapl_pkg</RootNamespace>
    <KMDF_VERSION_MAJOR>1</KMDF_VERSION_MAJOR>
    <KMDF_VERSION_MINOR>15</KMDF_VERSION_MINOR>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <RaplEnableMmioRead Condition="'$(RaplEnableMmioRead)' == ''">0</RaplEnableMmioRead>
    <RaplMmioLayoutValidated Condition="'$(RaplMmioLayoutValidated)' == ''">0</RaplMmioLayoutValidated>
    <RaplEnableLiveWrites Condition="'$(RaplEnableLiveWrites)' == ''">0</RaplEnableLiveWrites>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <TargetVersion>Windows10</TargetVersion>
    <UseDebugLibraries Condition="'$(Configuration)' == 'Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)' != 'Debug'">false</UseDebugLibraries>
    <DriverTargetPlatform>Windows Driver</DriverTargetPlatform>
    <DriverType>KMDF</DriverType>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <ConfigurationType>Driver</ConfigurationType>
    <Driver_SpectreMitigation>Spectre</Driver_SpectreMitigation>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <TargetName>rapl-pkg</TargetName>
    <OutDir>$(MSBuildThisFileDirectory)..\target\driver\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(MSBuildThisFileDirectory)..\target\driver\obj\$(Platform)\$(Configuration)\</IntDir>
    <SignMode>Off</SignMode>
    <!-- Stricter than the WDK default (DriverMinimumRules) whenever code analysis runs. -->
    <CodeAnalysisRuleSet>$(WDKContentRoot)CodeAnalysis\DriverRecommendedRules.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>RAPL_ENABLE_MMIO_READ=$(RaplEnableMmioRead);RAPL_MMIO_LAYOUT_VALIDATED=$(RaplMmioLayoutValidated);RAPL_ENABLE_LIVE_WRITES=$(RaplEnableLiveWrites);%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <TreatLinkerWarningAsErrors>true</TreatLinkerWarningAsErrors>
    </Link>
    <DriverSign>
      <FileDigestAlgorithm>sha256</FileDigestAlgorithm>
    </DriverSign>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="src\driver.c" />
    <ClInclude Include="include\rapl_ioctl.h" />
    <Inf Include="inf\rapl-pkg.inf">
      <SpecifyDriverDirectiveVersion>true</SpecifyDriverDirectiveVersion>
      <TimeStamp>0.3.0.0</TimeStamp>
    </Inf>
    <FilesToPackage Include="$(TargetPath)" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
